# انسخ الملف ده باسم .env (في نفس الفولدر) وحط قيم مشروعك من Supabase
# Supabase Dashboard → Project Settings → API (أو API Keys)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# المفتاح العام فقط: anon public (أو publishable key اللي بيبدأ بـ sb_publishable_)
# ممنوع تحط service_role / secret key هنا نهائيًا
VITE_SUPABASE_ANON_KEY=PUT-ANON-OR-PUBLISHABLE-KEY-HERE
